[Unit]
Description=PYBOARD Persistent Virtual Microphone
After=pipewire.service pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/pyboard-virtual-mic start
ExecStop=%h/.local/bin/pyboard-virtual-mic stop

[Install]
WantedBy=default.target
